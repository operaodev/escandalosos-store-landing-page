---
import { Phone } from "@lucide/astro";

const WHATSAPP = "51989106360";
const message = encodeURIComponent(
    "Hola, quiero hacer una recarga en Panda Store.",
);
---

<a
    href={`https://wa.me/${WHATSAPP}?text=${message}`}
    target="_blank"
    rel="noopener noreferrer"
    class="contact-fab group fixed bottom-5 right-5 sm:bottom-6 sm:right-6 md:bottom-7 md:right-7 z-40 inline-flex items-center justify-center size-14 sm:size-16 md:size-18 rounded-full border border-green-400/30 bg-green-500/10 text-green-100 shadow-lg shadow-green-500/10 backdrop-blur-md transition-all duration-300 hover:border-green-400/50 hover:bg-green-500/20 hover:text-white active:scale-95"
    aria-label="Contactar por WhatsApp"
    data-contact-fab
>
    <Phone class="w-6 h-6 sm:w-7 sm:h-7 md:w-8 md:h-8 text-green-300 transition-colors group-hover:text-green-200" />
</a>

<style>
    .contact-fab {
        opacity: 0;
        visibility: hidden;
        transform: translateY(0.75rem);
        transition:
            opacity 300ms ease,
            transform 300ms ease,
            visibility 300ms ease,
            background-color 200ms ease,
            border-color 200ms ease,
            color 200ms ease;
    }

    .contact-fab.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
</style>

<script>
    function initContactFab() {
        const fab = document.querySelector<HTMLElement>("[data-contact-fab]");
        if (!fab || fab.dataset.fabInit) return;
        fab.dataset.fabInit = "true";

        const update = () => {
            fab.classList.toggle("is-visible", window.scrollY > 8);
        };

        update();
        window.addEventListener("scroll", update, { passive: true });
    }

    initContactFab();
    document.addEventListener("astro:page-load", initContactFab);
</script>
