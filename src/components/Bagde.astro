---
interface Props {
    text?: string;
    className: string;
}

const { text, className } = Astro.props;
---

<div
    class:list={[
        "flex items-center border gap-2 rounded-full px-3 py-1 text-xs md:text-sm lg:text-base font-medium",
        className,
    ]}
>
    <span class="w-5 flex items-center">
        <slot />
    </span>
    {text && <span class="text-nowrap">{text}</span>}
</div>
